<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ration-terminal-title'}"
                      SetSize="640 480"
                      MinSize="480 320">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
        <Label Name="EmptyLabel"
               Text="{Loc 'ration-terminal-empty'}"
               Align="Center"
               Visible="False"
               Margin="8"/>
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Rows" Orientation="Vertical" HorizontalExpand="True" Margin="8"/>
        </ScrollContainer>
        <Button Name="IssueAllButton"
                Text="{Loc 'ration-terminal-issue-all'}"
                Margin="8"/>
    </BoxContainer>
</controls:FancyWindow>
