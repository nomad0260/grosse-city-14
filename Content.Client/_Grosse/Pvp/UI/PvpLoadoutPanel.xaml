<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Компактное меню предвыбора (команда + класс). Показывается по кнопке режима в лобби. -->
    <PanelContainer Name="MenuPanel" StyleClasses="PvpMenuPanel" Visible="False">
        <BoxContainer Name="Contents" Orientation="Vertical" SeparationOverride="4">
            <Label Name="TeamCounts" HorizontalAlignment="Center" Margin="2 2" />
            <Label Name="StatusLabel" HorizontalAlignment="Center" Margin="2 0 2 2" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="6" Margin="0 0 0 2">
                <Button Name="AttackersButton" Text="{Loc 'pvp-team-attackers'}" ToggleMode="True" />
                <Button Name="DefendersButton" Text="{Loc 'pvp-team-defenders'}" ToggleMode="True" />
                <Button Name="RandomButton" Text="{Loc 'pvp-lobby-random'}" ToggleMode="True" />
            </BoxContainer>
            <Label Text="{Loc 'pvp-lobby-select-class'}" HorizontalAlignment="Center" />
            <ScrollContainer MaxHeight="180" HorizontalExpand="True">
                <BoxContainer Name="ClassList" Orientation="Vertical" HorizontalExpand="True" />
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
