<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Компактное меню предвыбора: две команды, «Рандом» и короткий список классов. -->
    <PanelContainer Name="MenuPanel" StyleClasses="PvpMenuPanel" Visible="False">
        <BoxContainer Name="Contents" Orientation="Vertical" SeparationOverride="6">
            <GridContainer Name="TeamButtons" Columns="2" HorizontalExpand="True"
                           HSeparationOverride="4" VSeparationOverride="4">
                <Button Name="AttackersButton" Text="{Loc 'pvp-team-attackers'}" ToggleMode="True"
                        HorizontalExpand="True" MinHeight="34" StyleClasses="PvpTeamAttackers" />
                <Button Name="DefendersButton" Text="{Loc 'pvp-team-defenders'}" ToggleMode="True"
                        HorizontalExpand="True" MinHeight="34" StyleClasses="PvpTeamDefenders" />
            </GridContainer>
            <Button Name="RandomButton" Text="{Loc 'pvp-lobby-random'}" ToggleMode="True"
                    HorizontalExpand="True" MinHeight="28" />
            <PanelContainer StyleClasses="LobbyDivider" MinHeight="1" Margin="0 1" />
            <ScrollContainer Name="ClassScroll" Access="Public" MaxHeight="168" HorizontalExpand="True"
                             HScrollEnabled="False" ReserveScrollbarSpace="True" ReturnMeasure="True">
                <BoxContainer Name="ClassList" Orientation="Vertical" HorizontalExpand="True"
                              SeparationOverride="3" />
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
