<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="РТМ · Охладитель"
                      MinSize="660 470"
                      SetSize="700 510">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">

        <!-- Бак охладителя. -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#0C0A0A" BorderColor="#2A1416" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="КОНТУР ОХЛАЖДЕНИЯ" StyleClasses="LabelKeyText" FontColorOverride="#E23B3B"
                           HorizontalExpand="True"/>
                    <Label Name="CoolingLabel" Access="Public" Text="0 ед./с"/>
                </BoxContainer>

                <BoxContainer Orientation="Horizontal">
                    <Label Text="Хладагент" HorizontalExpand="True"/>
                    <Label Name="CoolantLabel" Access="Public" Text="—" ClipText="True"/>
                </BoxContainer>
                <ProgressBar Name="CoolantBar" Access="Public" MinHeight="12"/>
                <Label Name="CoolantVolumeLabel" Access="Public" Text="0 / 300 ед."
                       StyleClasses="LabelSubText"/>

                <BoxContainer Orientation="Horizontal">
                    <Label Text="Отработка" HorizontalExpand="True"/>
                    <Label Name="WasteLabel" Access="Public" Text="0 / 150 ед."/>
                </BoxContainer>
                <ProgressBar Name="WasteBar" Access="Public" MinHeight="12"/>
            </BoxContainer>
        </PanelContainer>

        <!-- Ячейки: откуда берём жидкость и куда сливаем. -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True">

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#0C0A0A" BorderColor="#2A1416" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
                    <Label Text="ОТКУДА ЗАЛИВАТЬ" FontColorOverride="#E23B3B"/>
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                        <SpriteView Name="CoolantSlotView" Access="Public" Scale="2 2" MinSize="56 56"/>
                        <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="2"
                                      MinWidth="130">
                            <Label Name="CoolantSlotLabel" Access="Public" Text="ячейка пуста" ClipText="True"/>
                            <Label Name="CoolantSlotFill" Access="Public" Text="—"
                                   StyleClasses="LabelSubText"/>
                        </BoxContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="InsertCoolantButton" Access="Public" Text="Вложить" HorizontalExpand="True"/>
                        <Button Name="EjectCoolantButton" Access="Public" Text="Забрать" HorizontalExpand="True"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#0C0A0A" BorderColor="#2A1416" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="5">
                    <Label Text="КУДА СЛИВАТЬ" FontColorOverride="#E23B3B"/>
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                        <SpriteView Name="WasteSlotView" Access="Public" Scale="2 2" MinSize="56 56"/>
                        <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="2"
                                      MinWidth="130">
                            <Label Name="WasteSlotLabel" Access="Public" Text="ячейка пуста" ClipText="True"/>
                            <Label Name="WasteSlotFill" Access="Public" Text="—"
                                   StyleClasses="LabelSubText"/>
                        </BoxContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="InsertWasteButton" Access="Public" Text="Вложить" HorizontalExpand="True"/>
                        <Button Name="EjectWasteButton" Access="Public" Text="Забрать" HorizontalExpand="True"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Действия с жидкостью. -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#0C0A0A" BorderColor="#2A1416" BorderThickness="1"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
                <Label Text="ДЕЙСТВИЯ" StyleClasses="LabelKeyText" FontColorOverride="#E23B3B"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Button Name="FillButton" Access="Public" Text="Залить в бак"
                            HorizontalExpand="True" MinHeight="30"/>
                    <Button Name="DrainWasteButton" Access="Public" Text="Слить отработку"
                            HorizontalExpand="True" MinHeight="30"/>
                    <Button Name="DrainAllButton" Access="Public" Text="Слить всё в тару"
                            HorizontalExpand="True" MinHeight="30"/>
                </BoxContainer>
                <Label Text="«Слить отработку» убирает только грязную жидкость, «Слить всё» — весь бак целиком."
                       StyleClasses="LabelSubText" ClipText="True"/>
            </BoxContainer>
        </PanelContainer>

        <Label Name="StatusLabel" Access="Public" Text="" ClipText="True"
               StyleClasses="LabelSubText"/>
    </BoxContainer>
</controls:FancyWindow>
