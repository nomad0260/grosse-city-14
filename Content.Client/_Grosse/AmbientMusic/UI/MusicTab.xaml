<Control xmlns="https://spacestation14.io"
         xmlns:ui="clr-namespace:Content.Client.Options.UI"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
        <PanelContainer StyleClasses="BackgroundPanel" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="16 12 16 12" SeparationOverride="10">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-player-heading'}"
                           StyleClasses="LabelKeyText"
                           HorizontalExpand="True" />
                    <Label Name="StateLabel" StyleClasses="LabelSubText" />
                </BoxContainer>

                <PanelContainer StyleClasses="BackgroundPanelDark">
                    <BoxContainer Orientation="Vertical" Margin="14 12 14 12" SeparationOverride="8">
                        <Label Name="TrackLabel"
                               Text="{Loc 'ui-options-player-nothing'}"
                               StyleClasses="LabelHeadingBigger"
                               ClipText="True" />

                        <Label Name="ArtistLabel"
                               StyleClasses="LabelSubText"
                               ClipText="True"
                               Visible="False" />

                        <ProgressBar Name="TrackProgress"
                                     MinValue="0"
                                     MaxValue="1"
                                     MinHeight="8">
                            <ProgressBar.ForegroundStyleBoxOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#E51E2A" />
                            </ProgressBar.ForegroundStyleBoxOverride>
                        </ProgressBar>

                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                            <Label Name="PositionLabel" Text="00:00" StyleClasses="LabelSubText" />
                            <Control HorizontalExpand="True" />
                            <Label Name="LengthLabel" Text="00:00" StyleClasses="LabelSubText" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
                            <Button Name="PreviousButton"
                                    Text="{Loc 'ui-options-player-previous'}"
                                    StyleClasses="ButtonBig"
                                    HorizontalExpand="True" />
                            <Button Name="PauseButton"
                                    Text="{Loc 'ui-options-player-pause'}"
                                    StyleClasses="ButtonBig"
                                    HorizontalExpand="True" />
                            <Button Name="NextButton"
                                    Text="{Loc 'ui-options-player-next'}"
                                    StyleClasses="ButtonBig"
                                    HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <ui:OptionSlider Name="SliderVolume" Title="{Loc 'ui-options-ambient-music-volume'}" />

                <Label Text="{Loc 'ui-options-player-hint'}" StyleClasses="LabelSubText" />
            </BoxContainer>
        </PanelContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
