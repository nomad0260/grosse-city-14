<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:pvp="clr-namespace:Content.Client._Grosse.Pvp.UI">

    <!-- Задний фон — заставка Half-Life 2 (City 17) -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" TexturePath="/Textures/_Grosse/hl2_city17.jpg" />

    <!-- Затемняющая подложка, чтобы панели читались поверх фотографии -->
    <PanelContainer Name="Scrim" StyleClasses="LobbyScrim" VerticalExpand="True" HorizontalExpand="True" />

    <!-- Центр экрана свободен: слева информация и чат, справа персонаж и действия -->
    <BoxContainer Name="MainContainer" Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True"
                  Margin="18" SeparationOverride="18">

        <!-- ЛЕВАЯ панель: сервер, раунд, информация, чат, ссылки -->
        <PanelContainer StyleClasses="LobbyPanel" MinWidth="400" MaxWidth="470" VerticalExpand="True"
                        HorizontalAlignment="Left">
            <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="14" VerticalExpand="True">
                <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger" HorizontalAlignment="Center" />
                <controls:HLine StyleClasses="highlight" Thickness="2" />

                <BoxContainer Orientation="Vertical" SeparationOverride="2">
                    <Label Name="StationTime" Access="Public" FontColorOverride="{x:Static maths:Color.LightGray}"
                           HorizontalAlignment="Left" />
                    <Label Name="StartTime" Access="Public" StyleClasses="LabelBig"
                           FontColorOverride="{x:Static maths:Color.LightGray}" HorizontalAlignment="Left" />
                </BoxContainer>

                <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30" VerticalExpand="False"
                                 HorizontalAlignment="Stretch" />

                <!-- Хост для попапов активных голосований (кнопка вызова голосования убрана) -->
                <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical" SeparationOverride="4"
                              HorizontalAlignment="Left" VerticalExpand="False" />

                <controls:HLine StyleClasses="highlight" Thickness="2" />

                <!-- Чат: MinWidth снят, иначе он шире панели -->
                <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" HorizontalExpand="True"
                                 Margin="0" MinWidth="0" MinHeight="120" />

                <controls:HLine StyleClasses="highlight" Thickness="2" />

                <!-- Правила / руководство / обновления -->
                <info:LinkBanner Name="LinkBanner" Access="Public" VerticalExpand="False" />
            </BoxContainer>
        </PanelContainer>

        <!-- СВОБОДНЫЙ ЦЕНТР -->
        <Control HorizontalExpand="True" />

        <!-- ПРАВАЯ панель: карточка персонажа и ровная колонка кнопок -->
        <PanelContainer Name="RightSide" Access="Public" StyleClasses="LobbyPanel" MinWidth="420" MaxWidth="900"
                        HorizontalExpand="False" HorizontalAlignment="Right" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="14" VerticalExpand="True">

                <!-- Состояние по умолчанию: карточка персонажа -->
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" VerticalExpand="True" SeparationOverride="10">

                        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public"
                                                           VerticalExpand="False" />

                        <pvp:PvpLoadoutPanel Name="PvpLoadout" Access="Public" />

                        <controls:HLine StyleClasses="highlight" Thickness="2" />

                        <Button Name="CharacterSetupButton" Access="Public" Disabled="True"
                                Text="{Loc 'ui-lobby-character-setup-button'}"
                                HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40" />

                        <!-- Растяжка: прижимает блок действий к низу панели -->
                        <Control VerticalExpand="True" MinHeight="10" />

                        <controls:HLine StyleClasses="highlight" Thickness="2" />

                        <!-- Все кнопки одинаковой ширины и высоты, в один ровный столбик -->
                        <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40" />

                        <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                            Text="{Loc 'ui-lobby-observe-button'}"
                                            HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40"
                                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />

                        <Button Name="OptionsButton" Access="Public" Text="{Loc 'ui-lobby-options-button'}"
                                HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40" />

                        <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40" />

                        <controls:HLine StyleClasses="highlight" Thickness="2" />

                        <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-button'}"
                                StyleClasses="negative"
                                HorizontalExpand="True" HorizontalAlignment="Stretch" MinHeight="40" />
                    </BoxContainer>
                </Control>

                <!-- Состояние редактирования: редактор персонажа -->
                <Control Name="CharacterSetupState" Access="Public" Visible="False" VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
