<ui:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
    xmlns:pvp="clr-namespace:Content.Client._Grosse.Pvp.UI"
    xmlns:combine="clr-namespace:Content.Client.UIpatch"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:tut="clr-namespace:Content.Client._Grosse.Lobby.UI">

    <!-- Задний фон — та же индустриальная сцена с медленным движением камеры -->
    <combine:LobbyBackdrop Name="Background" Access="Public" VerticalExpand="True" HorizontalExpand="True" />

    <!-- Кинематографичный скрим: направленный градиент и виньетка -->
    <combine:LobbyScrim Name="Scrim" VerticalExpand="True" HorizontalExpand="True" />

    <!-- Состояние по умолчанию -->
    <LayoutContainer Name="DefaultState" Access="Public" VerticalExpand="True" HorizontalExpand="True">

        <!-- Стекло и рамка под чатом: живёт внутри LayoutContainer, чтобы корректно позиционироваться. -->
        <combine:LobbyGlassPanel Name="ChatGlass" Access="Public" />

        <!-- Лобби-чат: живёт под панелями, чтобы не перекрывать меню и голосования. -->
        <widgets:ChatBox Name="Chat" Access="Public" />

        <!-- ВЕРХНЯЯ СТРОКА: АЙДЕНТИКА СЕРВЕРА СЛЕВА, СТАТУС СПРАВА -->
        <BoxContainer Name="TopBar" Access="Public" Orientation="Horizontal"
                      VerticalAlignment="Top" HorizontalExpand="True"
                      MinHeight="112" MaxHeight="112">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 22 4 0"
                          VerticalAlignment="Top" SeparationOverride="36">
                <BoxContainer Orientation="Horizontal" SeparationOverride="22" VerticalAlignment="Top">
                    <combine:LobbyEmblem MinSize="58 58" MaxSize="58 58" VerticalAlignment="Top"
                                         EmblemColor="#C8CBC4" Margin="0 6 0 0" />

                    <BoxContainer Orientation="Horizontal" SeparationOverride="18" VerticalAlignment="Top">
                        <PanelContainer MinWidth="1" MaxWidth="1" MinHeight="90" MaxHeight="90"
                                        StyleClasses="LobbyDivider" VerticalAlignment="Top" />
                        <BoxContainer Orientation="Vertical" SeparationOverride="3" VerticalAlignment="Top"
                                      Margin="0 4 0 0">
                            <Label Text="GROSSE CITY 14" StyleClasses="LobbyHeroTitle" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                                <Label Text="{Loc 'ui-lobby-hero-sub'}" StyleClasses="LobbyHeroSub" VerticalAlignment="Center" />
                                <Label Text="// C14-NODE" StyleClasses="LobbyTextAccent" VerticalAlignment="Center" />
                            </BoxContainer>
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>

                <Control HorizontalExpand="True" />

                <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalAlignment="Right"
                              VerticalAlignment="Top" MinWidth="190">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalAlignment="Right">
                        <combine:LobbyIcon Icon="Players" IconColor="#777970"
                                           MinSize="13 13" MaxSize="13 13" VerticalAlignment="Center" />
                        <Label Text="{Loc 'ui-lobby-players-online-label'}" StyleClasses="LobbyPlayersLabel"
                               VerticalAlignment="Center" />
                        <Label Name="TopPlayerCount" Access="Public" Text="0"
                               StyleClasses="LobbyPlayersValue" VerticalAlignment="Center" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LobbyDivider" HorizontalAlignment="Right"
                                    MinWidth="190" MaxWidth="260" MinHeight="1" MaxHeight="1" />

                    <!-- Часы и пинг не входят в референс; поля остаются для обновлений состояния. -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalAlignment="Right"
                                  Visible="False">
                        <Label Name="TopTime" Access="Public" Text="00:00"
                               StyleClasses="LobbyVersionLine LobbyTextMono" />
                        <Label Name="TopServerType" Access="Public" Text="{Loc 'ui-lobby-server-type-roleplay'}"
                               StyleClasses="LobbyVersionLine" />
                        <Label Name="TopPing" Access="Public" Text="{Loc 'ui-lobby-ping-unknown'}"
                               StyleClasses="LobbyVersionLine" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <!-- ЛЕВАЯ КОЛОНКА: МЕНЮ РАЗВЁРТЫВАНИЯ, СТАТУС УЗЛА И БЛОК ОТПРАВКИ -->
        <combine:LobbyGlassPanel Name="LeftSide" Access="Public"
                                 MinWidth="330" MaxWidth="400"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Left">
            <BoxContainer Orientation="Vertical" Margin="22 4 18 12" SeparationOverride="0"
                          HorizontalExpand="True">

                <Control Name="MenuTop" Access="Public" MinHeight="20" />

                <!-- Нумерованная координатная навигация -->
                <BoxContainer Name="DeployMenu" Orientation="Vertical" SeparationOverride="6"
                              HorizontalExpand="True">
                    <combine:LobbyMenuButton Name="DeployMenuRow" Access="Public" IsActive="True"
                                             MinHeight="50" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="34 0 12 0" SeparationOverride="14"
                                      HorizontalExpand="True">
                            <Label Text="01" StyleClasses="LobbyMenuIndexActive" MinWidth="42"
                                   VerticalAlignment="Center" />
                            <Control MinWidth="14" />
                            <Label Text="{Loc 'ui-lobby-menu-deploy'}" StyleClasses="LobbyMenuLabelActive"
                                   HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:LobbyMenuButton>

                    <combine:LobbyMenuButton Name="CharacterSetupButton" Access="Public"
                                             MinHeight="48" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="34 0 12 0" SeparationOverride="14"
                                      HorizontalExpand="True">
                            <Label Text="02" StyleClasses="LobbyMenuIndex" MinWidth="42"
                                   VerticalAlignment="Center" />
                            <Control MinWidth="14" />
                            <Label Text="{Loc 'ui-lobby-menu-personnel'}" StyleClasses="LobbyMenuLabel"
                                   HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:LobbyMenuButton>

                    <combine:LobbyMenuButton Name="TopUpdatesButton" Access="Public"
                                             MinHeight="48" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="34 0 12 0" SeparationOverride="14"
                                      HorizontalExpand="True">
                            <Label Text="03" StyleClasses="LobbyMenuIndex" MinWidth="42"
                                   VerticalAlignment="Center" />
                            <Control MinWidth="14" />
                            <Label Text="{Loc 'ui-lobby-menu-archive'}" StyleClasses="LobbyMenuLabel"
                                   HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:LobbyMenuButton>

                    <combine:LobbyMenuButton Name="OptionsButton" Access="Public"
                                             MinHeight="48" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="34 0 12 0" SeparationOverride="14"
                                      HorizontalExpand="True">
                            <Label Text="04" StyleClasses="LobbyMenuIndex" MinWidth="42"
                                   VerticalAlignment="Center" />
                            <Control MinWidth="14" />
                            <Label Text="{Loc 'ui-lobby-menu-settings'}" StyleClasses="LobbyMenuLabel"
                                   HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:LobbyMenuButton>

                    <combine:LobbyMenuButton Name="LeaveButton" Access="Public" ShowDivider="False"
                                             MinHeight="48" HorizontalExpand="True">
                        <BoxContainer Orientation="Horizontal" Margin="34 0 12 0" SeparationOverride="14"
                                      HorizontalExpand="True">
                            <Label Text="05" StyleClasses="LobbyMenuIndex" MinWidth="42"
                                   VerticalAlignment="Center" />
                            <Control MinWidth="14" />
                            <Label Name="LeaveLabel" Access="Public" Text="{Loc 'ui-lobby-menu-terminate'}" StyleClasses="LobbyMenuLabel"
                                   HorizontalExpand="True" VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:LobbyMenuButton>

                </BoxContainer>

                <!-- Небольшой фиксированный отступ между меню и статусом узла. -->
                <Control Name="MenuGap" Access="Public" MinHeight="12" />

                <!-- Статус узла -->
                <BoxContainer Name="NodeBlock" Access="Public" Orientation="Vertical"
                              SeparationOverride="6">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="34 0 0 0">
                        <PanelContainer Name="NodeDot" Access="Public" StyleClasses="LobbyNodeDot" MinSize="8 8" MaxSize="8 8"
                                        VerticalAlignment="Center" />
                        <Label Text="{Loc 'ui-lobby-node-status-label'}" StyleClasses="LobbyDeployRowKey" VerticalAlignment="Center" />
                        <Label Name="NodeStatusLabel" Access="Public" Text="{Loc 'ui-lobby-node-operational'}" StyleClasses="LobbyNodeStatus" VerticalAlignment="Center" />
                        <Control HorizontalExpand="True" />
                    </BoxContainer>

                    <combine:LobbySegmentedBar Name="NodeBar" Access="Public"
                                               MinWidth="156" MaxWidth="184"
                                               MinHeight="6" MaxHeight="6" HorizontalExpand="False"
                                               Fill="0.65" Segments="14" ShowArrow="False" Slanted="True"
                                               ActiveColor="#D13239" InactiveColor="#262A29"
                                               Margin="34 2 0 0" />

                    <!-- Версия клиента, сборка и сервер -->
                    <BoxContainer Name="BuildBlock" Access="Public" Orientation="Vertical"
                                  SeparationOverride="3" Margin="34 10 0 0">
                        <Label Name="EngineVersionLabel" Access="Public" Text="SS14 v—"
                               StyleClasses="LobbyBuildLine" />
                        <Label Name="BuildDateLabel" Access="Public" Text="—"
                               StyleClasses="LobbyBuildLine" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                            <Label Text="{Loc 'ui-lobby-server-line'}" StyleClasses="LobbyBuildLine" />
                            <Label Name="TopServerName" Access="Public" Text="—"
                                   StyleClasses="LobbyBuildLine" ClipText="True" HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>

                    <!-- Обратный отсчёт виден только перед стартом смены. -->
                    <Label Name="StartTime" Access="Public" Text="" Visible="False"
                           StyleClasses="LobbyShiftTimer" Margin="34 4 0 0" ClipText="True" />

                    <BoxContainer Name="AdminContainer" Access="Public" Orientation="Horizontal"
                                  SeparationOverride="8" MinHeight="16" Visible="False" Margin="56 0 0 0">
                        <combine:LobbyIcon Icon="Shield" IconColor="#E51E2A"
                                           MinSize="11 11" MaxSize="11 11" VerticalAlignment="Center" />
                        <Label Name="AdminLabel" Access="Public" Text="{Loc 'ui-lobby-admin-unknown'}"
                               StyleClasses="LobbyMonoSmall" VerticalAlignment="Center" ClipText="True" />
                    </BoxContainer>
                </BoxContainer>

                <Control Name="NodeGap" Access="Public" VerticalExpand="True" MinHeight="12" />

                <!-- Блок развёртывания -->
                <BoxContainer Name="DeployBlock" Access="Public" Orientation="Vertical"
                              SeparationOverride="9" Margin="56 0 0 0" Visible="False">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                        <Label Text="DEPLOYMENT_SEQUENCE" StyleClasses="LobbyDeployHeading"
                               VerticalAlignment="Center" />
                        <combine:LobbyHazardStripe MinHeight="5" MaxHeight="5" MinWidth="48"
                                                   HorizontalExpand="True" VerticalAlignment="Center"
                                                   Margin="0 2 0 0" />
                    </BoxContainer>

                    <Label Text="PREPARATION FOR SHIFT..." StyleClasses="LobbyDeployRowKey" />

                    <BoxContainer Orientation="Horizontal" SeparationOverride="11">
                        <Label Text="Sector:" StyleClasses="LobbyDeployRowKey" MinWidth="72" />
                        <Label Name="MapNameLabel" Access="Public" Text="{Loc 'ui-lobby-map-unknown'}"
                               StyleClasses="LobbyDeployRowValue" ClipText="True" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="11">
                        <Label Text="Crew:" StyleClasses="LobbyDeployRowKey" MinWidth="72" />
                        <Label Name="PlayersInRoundLabel" Access="Public" Text="0"
                               StyleClasses="LobbyDeployRowValue" ClipText="True" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="11">
                        <Label Text="Mode:" StyleClasses="LobbyDeployRowKey" MinWidth="72" />
                        <Label Name="GameModeLabel" Access="Public" Text="{Loc 'ui-lobby-mode-roleplay'}"
                               StyleClasses="LobbyDeployRowValue" ClipText="True" HorizontalExpand="True" />
                    </BoxContainer>

                    <!-- Служебные поля сохранены для обновлений состояния, но не входят в референс. -->
                    <BoxContainer Orientation="Vertical" Visible="False">
                        <Label Name="RoundStatus" Access="Public"
                               Text="{Loc 'lobby-state-player-status-round-not-started'}"
                               StyleClasses="LobbyMonoSmall" ClipText="True" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <Label Text="ROUND" StyleClasses="LobbyDeployRowKey" MinWidth="58" />
                            <Label Name="RoundNumberLabel" Access="Public" Text="#0"
                                   StyleClasses="LobbyDeployRowValue" ClipText="True" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <Label Text="STATIONS" StyleClasses="LobbyDeployRowKey" MinWidth="58" />
                            <Label Name="StationCountLabel" Access="Public" Text="0"
                                   StyleClasses="LobbyDeployRowValue" ClipText="True" HorizontalExpand="True" />
                        </BoxContainer>
                        <Label Name="GameModeDescription" Access="Public"
                               Text="{Loc 'ui-lobby-mode-roleplay-description'}"
                               StyleClasses="LobbyDeployDesc" ClipText="True" MaxHeight="14" />
                    </BoxContainer>
                </BoxContainer>

                <Control Name="ActionGap" Access="Public" MinHeight="16" />

                <!-- Главное действие -->
                <BoxContainer Name="ActionBlock" Access="Public" Orientation="Vertical"
                              SeparationOverride="6" Margin="34 0 0 0">
                    <combine:LobbyBracketButton Name="ReadyButton" Access="Public" ToggleMode="True"
                                                HorizontalExpand="True" MinHeight="64" MaxWidth="270">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="14 8 14 10"
                                      SeparationOverride="2">
                            <Label Name="ReadyKicker" Access="Public" Text="{Loc 'ui-lobby-deploy-kicker-idle'}"
                                   StyleClasses="LobbyTextAccent" />
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10">
                                <Label Name="ReadyLabel" Access="Public" Text="{Loc 'ui-lobby-deploy-action-idle'}"
                                       StyleClasses="LobbyDeployAction"
                                       HorizontalExpand="True" VerticalAlignment="Center" />
                                <combine:LobbyIcon Name="ReadyArrow" Access="Public" Icon="ArrowTopRight"
                                                   IconColor="#D13239" MinSize="16 16" MaxSize="16 16"
                                                   VerticalAlignment="Center" />
                            </BoxContainer>
                            <Label Name="ReadySubLabel" Access="Public" Text="{Loc 'ui-lobby-deploy-sub-idle'}"
                                   StyleClasses="LobbyDeployRowKey" ClipText="True" />
                        </BoxContainer>
                    </combine:LobbyBracketButton>

                    <!-- Состояние очереди и причина блокировки деплоя. -->
                    <Label Name="DeployStatus" Access="Public" Text=""
                           StyleClasses="LobbyDeployStatus" HorizontalExpand="True" Visible="False" />
                    <Label Name="DeployReason" Access="Public" Text=""
                           StyleClasses="LobbyDeployReason" HorizontalExpand="True" Visible="False" />

                    <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True">
                        <Label Name="ReadyText" Access="Public" Text="" StyleClasses="LobbyMonoSmall"
                               VerticalAlignment="Center" Visible="False" />
                        <Control HorizontalExpand="True" />
                        <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                            MinHeight="20" WindowType="{x:Type ui:ObserveWarningWindow}">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="6 0">
                                <Label Text="{Loc 'ui-lobby-observe-button'}"
                                       StyleClasses="LobbyObserveText" VerticalAlignment="Center" />
                                <combine:LobbyIcon Icon="Eye" IconColor="#969BA2"
                                                   MinSize="10 10" MaxSize="10 10" VerticalAlignment="Center" />
                            </BoxContainer>
                        </cc:UICommandButton>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </combine:LobbyGlassPanel>

        <!-- Голосования живут над нижней строкой и не растягивают левую колонку -->
        <BoxContainer Name="VoteContainer" Access="Public" Orientation="Vertical"
                      SeparationOverride="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      MinWidth="300" MaxWidth="360" />

        <!-- Свёрнутый чат на узких экранах: полоса с непрочитанными. -->
        <combine:CombineButton Name="ChatStrip" Access="Public" ButtonStyle="Secondary"
                               MinHeight="32" Visible="False">
            <BoxContainer Orientation="Horizontal" Margin="10 0" SeparationOverride="8">
                <combine:LobbyIcon Icon="Menu" IconColor="#AEB4BB"
                                   MinSize="14 14" MaxSize="14 14" VerticalAlignment="Center" />
                <Label Name="ChatStripLabel" Access="Public" Text="CHAT" StyleClasses="LobbyBottomHint" VerticalAlignment="Center" />
                <Label Name="ChatStripUnread" Access="Public" Text=""
                       StyleClasses="LobbyPlayersValue" VerticalAlignment="Center" />
            </BoxContainer>
        </combine:CombineButton>

        <!-- ПРАВАЯ КОЛОНКА: ДОСЬЕ И PVP-КАРТОЧКА -->
        <combine:LobbyGlassPanel Name="RightSide" Access="Public"
                                 MinWidth="300" MaxWidth="360"
                                 VerticalAlignment="Top" HorizontalAlignment="Right">
            <BoxContainer Orientation="Vertical" Margin="12 16 12 12" SeparationOverride="12"
                          HorizontalExpand="True">
                <ui:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />

                <Control Name="RightGap" Access="Public" VerticalExpand="True" MinHeight="8" />

                <BoxContainer Name="PvpCard" Access="Public" Orientation="Vertical"
                              Visible="False" SeparationOverride="6">
                    <combine:CombineButton Name="PvpMenuButton" Access="Public" ToggleMode="True"
                                           ButtonStyle="Secondary" HorizontalExpand="True" MinHeight="42">
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="10 2"
                                      SeparationOverride="10">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True"
                                          VerticalAlignment="Center" SeparationOverride="2">
                                <Label Name="PvpMenuTitle" Access="Public" Text="{Loc 'pvp-lobby-header'}"
                                       StyleClasses="LobbyTextSection" />
                                <Label Name="PvpMenuSummary" Access="Public"
                                       Text="{Loc 'pvp-lobby-summary-empty'}"
                                       StyleClasses="LobbyTextMuted" />
                            </BoxContainer>
                            <combine:LobbyIcon Name="PvpMenuChevron" Access="Public" Icon="ChevronRight"
                                               IconColor="#D7DADE" MinSize="12 12" MaxSize="12 12"
                                               VerticalAlignment="Center" />
                        </BoxContainer>
                    </combine:CombineButton>
                    <pvp:PvpLoadoutPanel Name="PvpLoadout" Access="Public" Visible="False" />
                </BoxContainer>
            </BoxContainer>
        </combine:LobbyGlassPanel>

        <!-- НИЖНЯЯ ПРАВАЯ СТРОКА: ПОДСКАЗКА ЧАТА -->
        <BoxContainer Name="BottomRight" Access="Public" Orientation="Horizontal"
                      SeparationOverride="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <!-- Escape-меню остаётся доступным по клавише; в референсе кнопки нет. -->
            <combine:CombineButton Name="MenuButton" Access="Public"
                                   ButtonStyle="Link" MinHeight="26" Visible="False">
                <BoxContainer Orientation="Horizontal" SeparationOverride="7" Margin="6 0">
                    <combine:LobbyIcon Icon="Menu" IconColor="#9FA29B"
                                       MinSize="16 16" MaxSize="16 16" VerticalAlignment="Center" />
                    <Label Text="Menu" StyleClasses="LobbyBottomHint" VerticalAlignment="Center" />
                </BoxContainer>
            </combine:CombineButton>
            <Label Name="ChatHint" Access="Public" Text="Press Tab to focus chat"
                   StyleClasses="LobbyBuildLine" VerticalAlignment="Center" />
            <combine:LobbyHazardStripe MinWidth="26" MinHeight="8" MaxHeight="8"
                                       StripeWidth="4" Gap="3" StripeColor="#D13239" VerticalAlignment="Center" />
        </BoxContainer>

        <!-- НИЖНЯЯ ЛЕВАЯ СТРОКА: МОНОХРОМНАЯ НАВИГАЦИЯ -->
        <BoxContainer Name="TopLeftPanel" Orientation="Horizontal"
                      SeparationOverride="36" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <combine:CombineButton Name="TopGuideButton" Access="Public"
                                   ButtonStyle="Link" MinHeight="26">
                <BoxContainer Orientation="Horizontal" SeparationOverride="7" Margin="2 0">
                    <combine:LobbyIcon Icon="Question" IconColor="#9FA29B"
                                       MinSize="15 15" MaxSize="15 15" VerticalAlignment="Center" />
                    <Label Text="{Loc 'ui-lobby-bottom-help'}" StyleClasses="LobbyBottomHint" VerticalAlignment="Center" />
                </BoxContainer>
            </combine:CombineButton>
            <combine:CombineButton Name="TutorialButton" Access="Public"
                                   ButtonStyle="Link" MinHeight="26">
                <BoxContainer Orientation="Horizontal" SeparationOverride="7" Margin="2 0">
                    <combine:LobbyIcon Icon="Menu" IconColor="#9FA29B"
                                       MinSize="15 15" MaxSize="15 15" VerticalAlignment="Center" />
                    <Label Text="{Loc 'ui-lobby-bottom-tutorial'}" StyleClasses="LobbyBottomHint" VerticalAlignment="Center" />
                </BoxContainer>
            </combine:CombineButton>
            <combine:CombineButton Name="AHelpButton" Access="Public"
                                   ButtonStyle="Link" MinHeight="26" Visible="False">
                <BoxContainer Orientation="Horizontal" SeparationOverride="7" Margin="2 0">
                    <combine:LobbyIcon Icon="Info" IconColor="#9FA29B"
                                       MinSize="15 15" MaxSize="15 15" VerticalAlignment="Center" />
                    <Label Text="{Loc 'ui-lobby-ahelp-button'}" StyleClasses="LobbyBottomHint" VerticalAlignment="Center" />
                </BoxContainer>
            </combine:CombineButton>
        </BoxContainer>
    </LayoutContainer>

    <!-- Состояние редактирования персонажа: обычный Control растягивает
         добавленный редактор на всю область, в отличие от LayoutContainer. -->
    <Control Name="CharacterSetupState" Access="Public" Visible="False"
             VerticalExpand="True" HorizontalExpand="True" />

    <!-- Отладочное наложение референса: включается командой lobbyref. -->
    <TextureRect Name="ReferenceOverlay" Access="Public"
                 Stretch="Scale" Visible="False" MouseFilter="Ignore" />

    <!-- Обучение при входе: чёрно-красный бриффинг поверх лобби. -->
    <tut:LobbyTutorialWindow Name="Tutorial" Access="Public" Visible="False" />

</ui:LobbyGui>
