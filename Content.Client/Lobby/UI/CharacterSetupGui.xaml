<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:style="clr-namespace:Content.Client.Stylesheets"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:combine="clr-namespace:Content.Client.UIpatch"
         VerticalExpand="True">
    <Control>
        <combine:LobbyGlassPanel Name="BackdropGlass" HorizontalExpand="True" VerticalExpand="True" />
        <PanelContainer Name="BackgroundPanel" />
        <BoxContainer Orientation="Vertical" SeparationOverride="0">
            <PanelContainer StyleClasses="LobbySetupHeader" MinSize="0 52" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" Margin="16 0" SeparationOverride="10">
                <Label Text="02 // PERSONNEL" StyleClasses="LobbySetupBreadcrumb"
                       VerticalAlignment="Center" Margin="0 0 8 0" />
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       VAlign="Center" StyleClasses="LobbySetupTitle" />

                <Control HorizontalExpand="True" />

                <cc:CommandButton Name="AdminRemarksButton"
                                  Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="LobbyButtonSecondary" MinHeight="32" />
                <!-- Corvax-Sponsor-Start -->
                <combine:CombineButton Name="SponsorButton"
                                       ButtonStyle="Secondary"
                                       Visible="False" MinHeight="32">
                    <Label Text="{Loc 'character-setup-gui-character-setup-sponsor-button'}"
                           StyleClasses="LobbyTextButton" Margin="12 0" VerticalAlignment="Center" />
                </combine:CombineButton>
                <!-- Corvax-Sponsor-End -->
                <combine:CombineButton Name="RulesButton"
                                       ButtonStyle="Secondary" MinHeight="32">
                    <Label Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                           StyleClasses="LobbyTextButton" Margin="12 0" VerticalAlignment="Center" />
                </combine:CombineButton>
                <combine:LobbyBracketButton Name="CloseButton"
                                            Access="Public"
                                            AccentColor="#D13239" MinHeight="32">
                    <Label Text="{Loc 'character-setup-gui-character-setup-back-button'}"
                           StyleClasses="LobbyTextButton" Margin="16 0" VerticalAlignment="Center" />
                </combine:LobbyBracketButton>
            </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="LobbyDivider" MinHeight="1" MaxHeight="1" />
            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="0">
                <ScrollContainer MinSize="330 0" Margin="10 10 8 10">
                    <BoxContainer Name="Characters" Orientation="Vertical" SeparationOverride="6" />
                </ScrollContainer>
                <PanelContainer MinWidth="1" MaxWidth="1" StyleClasses="LobbyDivider" />
                <BoxContainer Name="CharEditor" HorizontalExpand="True" Margin="8 6 10 10" />
            </BoxContainer>
        </BoxContainer>
    </Control>
</Control>
